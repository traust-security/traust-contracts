{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/traust-contracts/artifacts_schema/v1/model-registry.schema.json",
  "title": "Model Registry",
  "description": "Schema for config/model-registry.yaml \u2014 the single source of vendor/model identifiers and role routing policy (multi-model-strategy-plan M0).",
  "type": "object",
  "required": [
    "version",
    "updated",
    "tiers",
    "providers",
    "roles"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "tiers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          }
        }
      }
    },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "data_handling",
          "models"
        ],
        "additionalProperties": false,
        "properties": {
          "data_handling": {
            "type": "string",
            "minLength": 4
          },
          "connection": {
            "type": "object",
            "description": "How a runner reaches this provider: the wire it speaks, its endpoint, the harness fronting it and where its credential lives. Absent means the default: the Anthropic wire at its public endpoint, the credential already in the environment. The type names the wire and credential format, not the model family: anthropic, gemini and openai are proprietary endpoints (no base_url); anthropic-compatible and openai-compatible are gateways speaking an incumbent's wire (base_url required). Which types, harnesses and credential sources exist is the consumer's closed set, like tier names.",
            "required": [
              "type",
              "credential"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "base_url": {
                "type": "string",
                "minLength": 1,
                "description": "The endpoint override; required for the compatible types, forbidden for the proprietary ones."
              },
              "harness": {
                "type": "string",
                "minLength": 1,
                "description": "The harness a gateway connection fronts its wire with; absent keeps the worker's default."
              },
              "credential": {
                "type": "object",
                "description": "Where the provider's credential lives: source env reads the pod's existing environment; source secret names a Kubernetes Secret and the key within it.",
                "required": [
                  "source"
                ],
                "additionalProperties": false,
                "properties": {
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "key": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "models": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "required": [
                "tier",
                "batch_eligible"
              ],
              "additionalProperties": false,
              "properties": {
                "tier": {
                  "type": "string"
                },
                "batch_eligible": {
                  "type": "boolean"
                },
                "price_per_mtok_in": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "price_per_mtok_out": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "cache_read_multiplier": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1,
                  "description": "Cache-hit price as a fraction of price_per_mtok_in. Omit for the standard 0.1."
                },
                "long_prompt": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "above_tokens",
                    "price_per_mtok_in",
                    "price_per_mtok_out"
                  ],
                  "description": "Higher prices for a request whose prompt (input plus cache reads plus cache writes) is over above_tokens. They replace the base prices for every token of that request.",
                  "properties": {
                    "above_tokens": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "price_per_mtok_in": {
                      "type": "number",
                      "minimum": 0
                    },
                    "price_per_mtok_out": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "floor",
          "approved",
          "candidates",
          "ledger_validity_writer"
        ],
        "additionalProperties": false,
        "properties": {
          "floor": {
            "type": "string"
          },
          "approved": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ledger_validity_writer": {
            "type": "boolean"
          },
          "claude_code_only": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          },
          "evals": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "benchmarked_on": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "recall_delta": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "consistency": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "triggers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
