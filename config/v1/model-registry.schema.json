{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/traust-contracts/schemas/v1/model-registry.schema.json",
  "title": "Model Registry",
  "description": "Schema for config/model-registry.yaml \u2014 the single source of vendor/model identifiers and role routing policy (multi-model-strategy-plan M0).",
  "type": "object",
  "required": [
    "version",
    "updated",
    "tiers",
    "providers",
    "roles"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "tiers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          }
        }
      }
    },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "data_handling",
          "models"
        ],
        "additionalProperties": false,
        "properties": {
          "data_handling": {
            "type": "string",
            "minLength": 4
          },
          "connection": {
            "type": "object",
            "description": "Provider routing: the wire this provider speaks, its endpoint, its harness and where its credential lives. Routing data only, never the credentials themselves \u2014 a secret credential names the Secret and the key within it, and the credential reaches the worker on the deployment's existing mechanism. Absent keeps the default routing (the Anthropic wire, the pod's existing credential).",
            "required": [
              "type",
              "credential"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "anthropic",
                  "anthropic-compatible",
                  "gemini",
                  "openai",
                  "openai-compatible"
                ],
                "description": "The wire and credential format, not the model family: proprietary endpoints (anthropic, gemini, openai) or compatible gateways speaking an incumbent's wire (anthropic-compatible, openai-compatible). A gateway serving both wires appears as two providers."
              },
              "base_url": {
                "type": "string",
                "description": "The gateway endpoint. Required on the compatible types, which exist for endpoint overrides; empty on the proprietary types, whose default endpoint serves."
              },
              "harness": {
                "type": "string",
                "description": "The harness a gateway connection fronts its wire with (omp or claude); empty keeps the default."
              },
              "credential": {
                "type": "object",
                "description": "Where the provider's credential lives \u2014 a reference, never the credential itself. Source env reads the pod's existing environment; source secret names a Kubernetes Secret and the key within it, both required.",
                "required": [
                  "source"
                ],
                "additionalProperties": false,
                "properties": {
                  "source": {
                    "type": "string",
                    "enum": [
                      "env",
                      "secret"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "description": "The Secret's name (source secret)."
                  },
                  "key": {
                    "type": "string",
                    "description": "The credential's key within the Secret (source secret)."
                  }
                },
                "if": {
                  "properties": {
                    "source": {
                      "const": "secret"
                    }
                  },
                  "required": [
                    "source"
                  ]
                },
                "then": {
                  "required": [
                    "name",
                    "key"
                  ]
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "enum": [
                        "anthropic-compatible",
                        "openai-compatible"
                      ]
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "required": [
                    "base_url"
                  ],
                  "properties": {
                    "base_url": {
                      "minLength": 1
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "enum": [
                        "anthropic",
                        "gemini",
                        "openai"
                      ]
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "properties": {
                    "base_url": {
                      "maxLength": 0
                    }
                  }
                }
              }
            ]
          },
          "models": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "required": [
                "tier",
                "batch_eligible"
              ],
              "additionalProperties": false,
              "properties": {
                "tier": {
                  "type": "string"
                },
                "batch_eligible": {
                  "type": "boolean"
                },
                "price_per_mtok_in": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "price_per_mtok_out": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "cache_read_multiplier": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1,
                  "description": "Cache-hit price as a fraction of price_per_mtok_in. Omit for the standard 0.1."
                },
                "long_prompt": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "above_tokens",
                    "price_per_mtok_in",
                    "price_per_mtok_out"
                  ],
                  "description": "Higher prices for a request whose prompt (input plus cache reads plus cache writes) is over above_tokens. They replace the base prices for every token of that request.",
                  "properties": {
                    "above_tokens": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "price_per_mtok_in": {
                      "type": "number",
                      "minimum": 0
                    },
                    "price_per_mtok_out": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "floor",
          "approved",
          "candidates",
          "ledger_validity_writer"
        ],
        "additionalProperties": false,
        "properties": {
          "floor": {
            "type": "string"
          },
          "approved": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ledger_validity_writer": {
            "type": "boolean"
          },
          "claude_code_only": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          },
          "evals": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "benchmarked_on": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "recall_delta": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "consistency": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "triggers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
