{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/traust-contracts/artifacts_schema/v1/internal-vocabulary.schema.json",
  "title": "Internal Vocabulary",
  "description": "Schema for config/internal-vocabulary.yaml \u2014 organization-specific patterns for scan_internal_refs. Permissive by design: each rule requires id, tier and pattern (the load-bearing fields), while optional descriptive fields (why, notes) are unconstrained.",
  "type": "object",
  "required": [
    "rules"
  ],
  "additionalProperties": true,
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "tier",
          "pattern"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "type": "string",
            "enum": [
              "block",
              "review",
              "note"
            ]
          },
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string"
          }
        }
      }
    }
  }
}
