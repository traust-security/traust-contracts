{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/traust-contracts/artifacts_schema/v1/finding-intake.schema.json",
  "title": "Original native scanner finding bindings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_id",
    "repository_ref_id",
    "repository",
    "commit",
    "bindings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "repository_id": {
      "type": "string",
      "format": "uuid"
    },
    "repository_ref_id": {
      "type": "string",
      "format": "uuid"
    },
    "repository": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "commit": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "fingerprint_algo",
          "fingerprint"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "fingerprint_algo": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "fingerprint": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
