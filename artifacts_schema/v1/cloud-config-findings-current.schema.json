{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/traust-contracts/artifacts_schema/v1/cloud-config-findings-current.schema.json",
  "title": "Cloud config cumulative findings report (declared layer + dispositions)",
  "description": "Cumulative *-findings-current report derived by the track-findings cumulative builder from a *-cloud-config-audit.json baseline (schema/cloud-config-audit.schema.json) and its *-findings-layer.json disposition ledger. The finding core mirrors the cloud-config audit contract; build_cumulative adds the per-finding disposition block, validation_status, effective_severity, the top-level disposition_summary, the '\u2014 Cumulative Findings Status' title suffix, and metadata.additional.cumulative provenance (whose source_audit reference is also the validator's routing key). Strict where build_cumulative and the cloud-config validation gate guarantee the shape; permissive where audit vintages legitimately differ (extra metadata annotations such as tracking/campaign, free-form summary notes).",
  "type": "object",
  "required": [
    "title",
    "metadata",
    "summary",
    "findings",
    "disposition_summary"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "pattern": "\u2014 Cumulative Findings Status$",
      "description": "audit title with the suffix the cumulative builder always appends"
    },
    "metadata": {
      "type": "object",
      "required": [
        "target",
        "assessment_mode",
        "harness_version",
        "checkov_version",
        "facts_ref",
        "facts_snapshot_id",
        "deterministic_steps",
        "additional",
        "date"
      ],
      "$comment": "Deliberately open to additional keys: audit vintages carry campaign annotations (tracking, campaign, reconciliation_note, methodology_note, ...) that are not part of the core contract.",
      "properties": {
        "target": {
          "type": "string",
          "description": "target slug (scanned checkout's directory name)"
        },
        "assessment_mode": {
          "const": "declared",
          "description": "inherited from the cloud-config audit: declared configuration only"
        },
        "target_head": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "ref_kind": {
          "type": "string",
          "enum": [
            "branch",
            "tag",
            "default",
            "stream"
          ]
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "harness_version": {
          "type": "string"
        },
        "checkov_version": {
          "type": "string"
        },
        "facts_ref": {
          "type": "string",
          "description": "path of the sibling cloud-facts artifact"
        },
        "facts_snapshot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16,64}$"
        },
        "generated_at": {
          "type": "string"
        },
        "frameworks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deterministic_steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "tool",
              "invocation"
            ],
            "properties": {
              "tool": {
                "type": "string"
              },
              "invocation": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            }
          }
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "the cumulative builder sets this to the cumulative generation date (generated_at[:10])"
        },
        "additional": {
          "type": "object",
          "required": [
            "cumulative"
          ],
          "properties": {
            "cumulative": {
              "type": "object",
              "required": [
                "source_audit",
                "layer",
                "generated_at"
              ],
              "properties": {
                "source_audit": {
                  "type": "string",
                  "pattern": "-cloud-config-audit\\.json$",
                  "description": "the baseline audit filename stamped by the cumulative builder \u2014 also the validator's routing key for this schema"
                },
                "layer": {
                  "type": "string",
                  "description": "the *-findings-layer.json disposition ledger the dispositions were replayed from"
                },
                "original_report_date": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "generated_at": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "facts_total",
        "confirmed",
        "suppressed",
        "needs_review",
        "gaps"
      ],
      "$comment": "Copied through from the audit report. Open to the free-form annotations different vintages used (note, notes, statement, scope_statement).",
      "properties": {
        "facts_total": {
          "type": "integer",
          "minimum": 0
        },
        "confirmed": {
          "type": "integer",
          "minimum": 0
        },
        "suppressed": {
          "type": "integer",
          "minimum": 0
        },
        "needs_review": {
          "type": "integer",
          "minimum": 0
        },
        "gaps": {
          "type": "integer",
          "minimum": 0
        },
        "by_severity": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "by_provider": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "fact_ids",
          "framework",
          "provider",
          "check_id",
          "title",
          "severity",
          "status",
          "disposition",
          "validation_status",
          "effective_severity"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CCA-[A-Za-z0-9-]+-[0-9]{3}$"
          },
          "kind": {
            "$ref": "report.schema.json#/$defs/finding/properties/kind"
          },
          "fact_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^cca-[0-9a-f]{12}$"
            }
          },
          "framework": {
            "type": "string"
          },
          "provider": {
            "enum": [
              "aws",
              "azure",
              "gcp",
              "kubernetes",
              "docker",
              "other"
            ]
          },
          "check_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "informational"
            ]
          },
          "scanner_severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "informational",
              "unrated"
            ]
          },
          "status": {
            "enum": [
              "confirmed",
              "suppressed",
              "needs_review"
            ]
          },
          "rationale": {
            "type": "string"
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file_path": {
                  "type": "string"
                },
                "resource": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "file_line_range": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "cwe": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^CWE-[0-9]+$"
          },
          "control_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "remediation": {
            "type": [
              "string",
              "null"
            ]
          },
          "external_correlation": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "isolation_dimensions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "privilege",
                "encryption",
                "authentication",
                "connectivity",
                "hygiene"
              ]
            }
          },
          "isolation_boundary": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "type": "object",
            "required": [
              "validity",
              "resolution",
              "assurance",
              "last_updated",
              "events"
            ],
            "additionalProperties": false,
            "$comment": "Written by build_cumulative.derive_disposition \u2014 keep the key set and enums in sync with the track-findings cumulative builder.",
            "properties": {
              "validity": {
                "enum": [
                  "confirmed",
                  "corrected",
                  "false_positive",
                  "not_verified",
                  "hardening",
                  "not_affected",
                  "true_positive"
                ]
              },
              "resolution": {
                "enum": [
                  "open",
                  "fix_in_progress",
                  "resolved",
                  "partially_resolved",
                  "risk_accepted",
                  "regression_introduced"
                ]
              },
              "assurance": {
                "enum": [
                  "execution_proven",
                  "human_reviewed",
                  "machine_verified",
                  "claimed"
                ]
              },
              "evidence_grade": {
                "$ref": "layer.schema.json#/$defs/event/properties/evidence_grade"
              },
              "last_updated": {
                "type": "string"
              },
              "events": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "severity_override": {
                "type": "object",
                "required": [
                  "severity",
                  "by",
                  "at"
                ],
                "properties": {
                  "severity": {
                    "enum": [
                      "critical",
                      "high",
                      "medium",
                      "low",
                      "informational"
                    ]
                  },
                  "by": {
                    "type": "string"
                  },
                  "at": {
                    "type": "string"
                  },
                  "rationale": {
                    "type": "string"
                  }
                }
              },
              "conflict": {
                "const": true
              },
              "refuted_awaiting_signoff": {
                "const": true
              },
              "fp_overridden": {
                "const": true
              },
              "fp_reassertion_blocked": {
                "const": true
              }
            }
          },
          "validation_status": {
            "enum": [
              "confirmed",
              "corrected",
              "false_positive",
              "not_verified",
              "hardening",
              "not_affected",
              "true_positive"
            ],
            "description": "mirrors disposition.validity (cross-checked by the validator)"
          },
          "effective_severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "informational"
            ],
            "description": "disposition.severity_override.severity when a human override exists, else the finding's severity (cross-checked by the validator)"
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Deterministic cross-scan identity, same recipe as report.schema.json. Policy findings anchor on locations[].resource rather than a file path (files move; RoleBinding.ns.name does not) and append check_id, because the CHECK is what separates two findings on one resource -- without it 20 violations on a single Pod collapsed to one identity."
          },
          "fingerprint_algo": {
            "type": "string",
            "pattern": "^v\\d+$",
            "description": "Algorithm version of `fingerprint` (the identity module ALGO_VERSION). Mirrors report.schema.json and layer.schema.json: stamps outlive recipes, so matching fingerprints across an epoch boundary means comparing this field too."
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disposition_summary": {
      "type": "object",
      "required": [
        "layer_ref",
        "generated_at",
        "by_resolution",
        "by_validity",
        "severity_overrides",
        "conflicts",
        "needs_review_count"
      ],
      "additionalProperties": false,
      "properties": {
        "layer_ref": {
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        },
        "by_resolution": {
          "type": "object",
          "required": [
            "open",
            "fix_in_progress",
            "resolved",
            "partially_resolved",
            "risk_accepted",
            "regression_introduced"
          ],
          "additionalProperties": {
            "type": "integer"
          }
        },
        "by_validity": {
          "type": "object",
          "required": [
            "confirmed",
            "corrected",
            "false_positive",
            "not_verified",
            "hardening"
          ],
          "additionalProperties": {
            "type": "integer"
          }
        },
        "severity_overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "finding",
              "severity",
              "by",
              "at"
            ],
            "properties": {
              "finding": {
                "type": "string"
              },
              "from": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "severity": {
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low",
                  "informational"
                ]
              },
              "by": {
                "type": "string"
              },
              "at": {
                "type": "string"
              },
              "rationale": {
                "type": "string"
              }
            }
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "needs_review_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "canonical_write": {
      "description": "Opt-in original override severity from the existing severity vocabulary; default historical text remains readable.",
      "allOf": [
        { "$ref": "#" },
        {
          "properties": {
            "disposition_summary": {
              "properties": {
                "severity_overrides": {
                  "items": {
                    "properties": {
                      "from": {
                        "anyOf": [
                          { "$ref": "report.schema.json#/$defs/severity_level" },
                          { "type": "null" }
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
