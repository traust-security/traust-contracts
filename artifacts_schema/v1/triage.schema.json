{
  "$id": "https://example.com/traust-contracts/artifacts_schema/v1/triage.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Triage Report Schema",
  "description": "Output contract of the triage skill (TRIAGE.json / <repo>-triage.json). Finding kind is independent of the triage verdict: verified defense-in-depth gaps use true_positive with kind weakness. Historical hardening verdicts remain readable, but canonical_write rejects them. Omitted kind remains unknown. Severity, finding-kind and date vocabularies are shared with report.schema.json.",
  "type": "object",
  "required": [
    "triage_completed",
    "triage_context",
    "summary",
    "findings"
  ],
  "properties": {
    "triage_completed": {
      "description": "Date the verification run completed (not the re-emit date; see triage_context.reemitted).",
      "type": "string",
      "format": "date"
    },
    "triage_context": {
      "$ref": "#/$defs/triage_context"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "findings": {
      "type": "array",
      "minItems": 0,
      "$comment": "Empty is valid: a zero-finding audit yields a zero-finding triage.",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "severity_level": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "informational"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "true_positive",
        "hardening",
        "undetermined",
        "false_positive",
        "duplicate"
      ]
    },
    "triage_context": {
      "type": "object",
      "required": [
        "environment",
        "votes_per_finding",
        "repo",
        "harness_version"
      ],
      "properties": {
        "mode": {
          "type": "string"
        },
        "environment": {
          "type": "string",
          "minLength": 10
        },
        "threat_model": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "string"
            }
          ]
        },
        "scoring": {
          "type": "string"
        },
        "noise_tolerance": {
          "type": "string"
        },
        "votes_per_finding": {
          "type": "integer",
          "minimum": 1
        },
        "repo": {
          "type": "string"
        },
        "findings_path": {
          "type": "string"
        },
        "source_report": {
          "type": "string"
        },
        "harness_version": {
          "description": "Harness semver + short SHA at triage (or re-emit) time, e.g. 0.24.0-e240e87. Pins the verdict-taxonomy epoch.",
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-f0-9]{7,12})?$"
        },
        "rerun_of": {
          "type": "string"
        },
        "reemitted": {
          "type": "string",
          "format": "date"
        },
        "reemit_method": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "input_count",
        "true_positives",
        "hardening",
        "false_positives",
        "undetermined",
        "duplicates",
        "by_severity"
      ],
      "properties": {
        "input_count": {
          "type": "integer",
          "minimum": 0
        },
        "true_positives": {
          "description": "Actionable true_positive findings whose kind is not weakness; excludes the disjoint hardening bucket.",
          "type": "integer",
          "minimum": 0
        },
        "hardening": {
          "description": "Historical hardening verdicts and true_positive findings with kind weakness; excludes the true_positives bucket.",
          "type": "integer",
          "minimum": 0
        },
        "false_positives": {
          "type": "integer",
          "minimum": 0
        },
        "undetermined": {
          "type": "integer",
          "minimum": 0
        },
        "duplicates": {
          "type": "integer",
          "minimum": 0
        },
        "needs_manual_test": {
          "type": "integer",
          "minimum": 0
        },
        "by_severity": {
          "description": "Severity distribution of actionable non-weakness true positives only, using the report.schema.json severity vocabulary.",
          "type": "object",
          "required": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "properties": {
            "critical": {
              "type": "integer",
              "minimum": 0
            },
            "high": {
              "type": "integer",
              "minimum": 0
            },
            "medium": {
              "type": "integer",
              "minimum": 0
            },
            "low": {
              "type": "integer",
              "minimum": 0
            },
            "informational": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "vote_breakdown": {
      "type": "object",
      "required": [
        "true_positive",
        "hardening",
        "false_positive",
        "cannot_verify"
      ],
      "properties": {
        "true_positive": {
          "type": "integer",
          "minimum": 0
        },
        "hardening": {
          "type": "integer",
          "minimum": 0
        },
        "false_positive": {
          "type": "integer",
          "minimum": 0
        },
        "cannot_verify": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "title",
        "verdict"
      ],
      "properties": {
        "id": {
          "description": "Triage-local sequential id.",
          "type": "string",
          "pattern": "^f\\d{3,}$"
        },
        "orig_id": {
          "description": "The source scanner's finding id. When the input is a harness audit report this is the canonical {REPO_SLUG}-{SHORTSHA}-{NNN} id and is cross-checked.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 5
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": [
            "integer",
            "null"
          ]
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "claimed_severity": {
          "type": [
            "string",
            "null"
          ]
        },
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "kind": {
          "$ref": "report.schema.json#/$defs/finding/properties/kind",
          "description": "Finding kind, independent of verdict. Optional and non-null; omission preserves unknown kind rather than assuming vulnerability."
        },
        "verify_verdict": {
          "description": "exploitable|mitigated|needs_manual_test are the skill's canonical values; confirmed|refuted|hardening are accepted presentation aliases.",
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "exploitable",
            "mitigated",
            "needs_manual_test",
            "confirmed",
            "refuted",
            "hardening",
            null
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "severity": {
          "description": "Precondition-derived severity; set only on actionable non-weakness true positives (null for confirmed weaknesses and other verdicts).",
          "anyOf": [
            {
              "$ref": "#/$defs/severity_level"
            },
            {
              "type": "null"
            }
          ]
        },
        "severity_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity_alignment": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "access_level": {
          "type": [
            "string",
            "null"
          ]
        },
        "threat_match": {
          "type": [
            "string",
            "null"
          ]
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "recommendation": {
          "description": "Remediation guidance carried through verbatim from the input finding (e.g. a secure-code-audit report's remediation field), so /patch receives it on the canonical audit -> triage -> patch path. Null when the input had none.",
          "type": [
            "string",
            "null"
          ]
        },
        "vote_breakdown": {
          "anyOf": [
            {
              "$ref": "#/$defs/vote_breakdown"
            },
            {
              "type": "null"
            }
          ]
        },
        "refute_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclusion_rule": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "first_links": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "duplicate_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "absorbed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owner_hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "component": {
          "type": [
            "string",
            "null"
          ]
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Deterministic cross-scan identity (identity module fingerprint). Optional here -- no artifact of this kind carries one today -- but DECLARED, because additionalProperties is false and an undeclared identity field makes every stamped artifact invalid the moment a producer starts emitting it. That has happened twice: report.schema.json omitted fingerprint_algo for 16 days, and the cloud-config schema declared neither, so stamping the policy findings invalidated nearly every report in one command."
        },
        "fingerprint_algo": {
          "type": "string",
          "pattern": "^v\\d+$",
          "description": "Algorithm version of `fingerprint` (the identity module ALGO_VERSION). Declared for the same reason as `fingerprint` above."
        }
      },
      "additionalProperties": false
    },
    "canonical_write": {
      "description": "Opt-in canonical triage verdicts and claimed severity from the existing vocabulary. True-positive weaknesses require rule 13 and cannot carry non-null severity; true positives with rule 13 require explicit kind weakness. Deprecated hardening verdicts and historical claimed-severity text remain readable by default.",
      "allOf": [
        { "$ref": "#" },
        {
          "properties": {
            "findings": {
              "items": {
                "properties": {
                  "verdict": {
                    "not": { "const": "hardening" }
                  },
                  "claimed_severity": {
                    "anyOf": [
                      { "$ref": "report.schema.json#/$defs/severity_level" },
                      { "type": "null" }
                    ]
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "required": ["verdict", "kind"],
                      "properties": {
                        "verdict": { "const": "true_positive" },
                        "kind": { "const": "weakness" }
                      }
                    },
                    "then": {
                      "required": ["exclusion_rule"],
                      "properties": {
                        "severity": { "type": "null" },
                        "exclusion_rule": { "enum": [13, "13"] }
                      }
                    }
                  },
                  {
                    "if": {
                      "required": ["verdict", "exclusion_rule"],
                      "properties": {
                        "verdict": { "const": "true_positive" },
                        "exclusion_rule": { "enum": [13, "13"] }
                      }
                    },
                    "then": {
                      "required": ["kind"],
                      "properties": {
                        "kind": { "const": "weakness" }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    }
  }
}
