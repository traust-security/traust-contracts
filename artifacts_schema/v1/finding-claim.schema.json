{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/traust-contracts/artifacts_schema/v1/finding-claim.schema.json",
  "title": "Reviewed finding claim revision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "finding_id",
    "repository_id",
    "assessment_id",
    "label",
    "base",
    "claim"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "finding_id": {
      "type": "string",
      "format": "uuid"
    },
    "repository_id": {
      "type": "string",
      "format": "uuid"
    },
    "assessment_id": {
      "type": "string",
      "format": "uuid"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint_algo",
        "fingerprint",
        "title",
        "claim_decision_id",
        "occurrence_ids"
      ],
      "properties": {
        "fingerprint_algo": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "claim_decision_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "occurrence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "fingerprint_algo",
        "fingerprint",
        "cwes",
        "category",
        "locations"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "fingerprint_algo": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "cwes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CWE-[0-9]+$"
          },
          "uniqueItems": true
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "line_start",
              "line_end",
              "symbol"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "line_start": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "line_end": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "symbol": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
